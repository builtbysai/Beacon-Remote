[Unit]
Description=Weekly Beacon Remote restore drill: the latest encrypted backup restored into a throwaway database
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=REMOTE_ALLOW_ISOLATED_RESTORE=RESTORE_A_SEPARATE_DATABASE
Environment=REMOTE_RESTORE_SCHEMA_ONLY=1
ExecStart=/usr/bin/docker compose --project-name beacon-remote --env-file /etc/beacon-remote/production.env --file /opt/beacon-remote/current/infrastructure/oracle/compose.yaml run --rm --no-deps --interactive=false restore-check
