FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/protocol packages/protocol
RUN pnpm install --frozen-lockfile
COPY apps/backend apps/backend
RUN pnpm --filter @beacon-remote/backend build
RUN pnpm --filter @beacon-remote/backend deploy --prod /runtime

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build --chown=node:node /runtime /app/apps/backend
USER node
CMD ["node", "apps/backend/dist/apps/backend/src/index.js"]
