# Written for you by ./beaconctl setup. Every secret below is generated on this server; none is ever committed.
DOMAIN=remote.example.com
# The address people on the internet reach this server at (for the relay).
PUBLIC_IP=203.0.113.10
REMOTE_ADMIN_PASSWORD=
REMOTE_DB_PASSWORD=
SESSION_SECRET=
TURN_SECRET=

# Optional: a public STUN server, as stun:host:port. The relay above is used regardless.
STUN_URL=
# Optional: email for sign-up and recovery (Resend). Leave empty to keep accounts invitation-only.
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_SIGNUP=
