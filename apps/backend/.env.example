DATABASE_URL=postgresql://remote_dev:development-only@127.0.0.1:5433/beacon_remote_dev
WEB_ORIGIN=http://127.0.0.1:5174
HOST=127.0.0.1
PORT=3010
NODE_ENV=development
# Media is opt-in. Supply SESSION_SECRET privately: 64 lowercase hex characters.
# Relay credentials: configure both
# TURN_URLS and TURN_SECRET privately. TURN_SECRET must match Coturn REST auth.
# TURN_URLS=turn:relay.example.com:3478?transport=udp
# Native RTC currently supports UDP TURN only; TCP/TLS URLs are rejected.
# ICE_TRANSPORT_POLICY=all
# Use relay only for forced-relay acceptance; matching native build required.
# Never put real secrets in this example or source control.
