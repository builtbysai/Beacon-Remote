{
  "name": "@beacon-remote/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:native": "tsx scripts/verify-native-presence.ts",
    "start": "node dist/apps/backend/src/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "account:create": "tsx scripts/create-account.ts"
  },
  "dependencies": {
    "@beacon-remote/protocol": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "^11.3.3",
    "@node-rs/argon2": "2.0.2",
    "fastify": "5.12.5",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/ws": "^8.18.2",
    "tsx": "4.23.15",
    "ws": "^8.22.0"
  }
}
