<?xml version="1.0" encoding="utf-8"?>
<!-- Atkinson Hyperlegible Next, the web workspace's typeface: one variable file, three named weights. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/atkinson_next_var" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/atkinson_next_var" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
    <font android:font="@font/atkinson_next_var" android:fontStyle="normal" android:fontWeight="800" android:fontVariationSettings="'wght' 800" />
</font-family>
